{
  "name": "blockstrike",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "shared",
    "client",
    "server"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @blockstrike/client",
    "build": "npm run build --workspace @blockstrike/client",
    "preview": "npm run preview --workspace @blockstrike/client",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p shared && tsc -p shared/tsconfig.test.json && tsc -p client && tsc -p server",
    "smoke": "npm run smoke --workspace @blockstrike/server"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
