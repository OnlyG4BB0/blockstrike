{
  "name": "blockstrike",
  "private": true,
  "version": "0.2.2",
  "type": "module",
  "workspaces": [
    "shared",
    "client",
    "server"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:client": "npm run dev --workspace @blockstrike/client",
    "dev:server": "npm run dev --workspace @blockstrike/server",
    "build": "npm run build --workspace @blockstrike/client",
    "preview": "npm run preview --workspace @blockstrike/client",
    "start": "npm run start --workspace @blockstrike/server",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p shared && tsc -p shared/tsconfig.test.json && tsc -p client && tsc -p client/tsconfig.test.json && tsc -p server",
    "smoke": "npm run smoke --workspace @blockstrike/server",
    "smoke:net": "npm run smoke:net --workspace @blockstrike/server",
    "build:android": "node scripts/build-android.mjs",
    "deploy:pages": "node scripts/deploy-pages.mjs",
    "publish:repo": "node scripts/publish-repo.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
